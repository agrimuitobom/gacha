{
  "name": "coordi-gacha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "天気と予定に合わせて、手持ちの服から今日のコーデを提案するアプリ",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.js",
    "test": "npm run build && node tests/css-coverage.mjs",
    "emulators": "firebase emulators:start --project demo-gacha --only auth,firestore,storage",
    "build:emulator": "vite build --mode emulator",
    "preview:emulator": "vite preview --mode emulator --port 4173",
    "test:rules": "node tests/rules.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:css": "node tests/css-coverage.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide": "^1.45.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "firebase-tools": "^15.30.0",
    "playwright": "^1.57.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
