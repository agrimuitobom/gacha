# ローカルの Firebase エミュレータに接続するための設定。
# すべてダミー値で、実際のプロジェクトには接続しない。
#   npm run emulators        # 別ターミナルでエミュレータを起動
#   npm run build:emulator   # この設定でビルド
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-gacha.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-gacha
VITE_FIREBASE_STORAGE_BUCKET=demo-gacha.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_FIREBASE_EMULATOR=true
# 予定の通知のテスト専用の鍵（秘密鍵は tests/push.mjs にある。本番では使わないこと）
VITE_VAPID_PUBLIC_KEY=BF1I_EzCse0NFy_YJNIz9kLfgpOceVf4u_r1u3BMUE7W7KBpca6C9mRzkBueRZ3_KoqZr2saH5ygzT99O5Av5NU
