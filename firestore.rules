rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // データは users/{uid} 配下にのみ置く。
    // 他ユーザーのドキュメントへ到達する経路をそもそも作らない。
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isInt(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    function isText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // 'YYYY-MM-DD'
    function isDateKey(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isOptionalId(value) {
      return value == null || value is string;
    }

    function isTimestampMs(value) {
      return value is int && value > 0;
    }

    function validClosetItem(data) {
      return data.keys().hasOnly([
               'category', 'name', 'imageUrl', 'imagePath', 'colorClass',
               'warmth', 'formality', 'rainSafe', 'available', 'createdAt'
             ])
             && data.category in ['outer', 'tops', 'bottoms', 'shoes', 'accessory']
             && isText(data.name, 40)
             && isInt(data.warmth, 1, 5)
             && isInt(data.formality, 1, 3)
             && data.rainSafe is bool
             // この項目が無い時期のアイテムも通るよう、既定値を与えてから検証する
             && data.get('available', true) is bool
             && isTimestampMs(data.createdAt)
             && (data.imageUrl == null || data.imageUrl is string)
             // 画像は必ず自分の領域を指していること
             && (data.imagePath == null ||
                 (data.imagePath is string &&
                  data.imagePath.matches('^users/' + request.auth.uid + '/closet/.*')))
             && (data.colorClass == null || isText(data.colorClass, 40));
    }

    function validSchedule(data) {
      return data.keys().hasOnly(['date', 'time', 'title', 'createdAt'])
             && isDateKey(data.date)
             && isText(data.time, 10)
             && isText(data.title, 60)
             && isTimestampMs(data.createdAt);
    }

    function validOutfit(data) {
      return data.keys().hasOnly(['date', 'outerId', 'topsId', 'bottomsId', 'shoesId', 'accessoryId', 'decidedAt', 'createdAt'])
             && isDateKey(data.date)
             // フィールドが無いドキュメント（outerId を持たない古い記録など）でも
             // 弾かれないよう、get で既定値を与えてから検証する。
             // data.outerId と直接書くと、未設定のとき評価自体が失敗する。
             && isOptionalId(data.get('outerId', null))
             && isOptionalId(data.get('topsId', null))
             && isOptionalId(data.get('bottomsId', null))
             && isOptionalId(data.get('shoesId', null))
             && isOptionalId(data.get('accessoryId', null))
             && isTimestampMs(data.decidedAt)
             && isTimestampMs(data.createdAt);
    }

    // 予定の通知先（ブラウザの PushSubscription）。端末ごとに1件。
    // 送信は GitHub Actions が Admin SDK で読むので、ルールの対象外。
    function validPushSubscription(data) {
      return data.keys().hasOnly([
               'endpoint', 'p256dh', 'auth', 'leadMinutes', 'timeZone', 'createdAt', 'updatedAt'
             ])
             && data.endpoint is string
             && data.endpoint.size() <= 1000
             && data.endpoint.matches('^https://.+')
             && isText(data.p256dh, 200)
             && isText(data.auth, 100)
             && data.leadMinutes in [15, 30, 60, 120]
             && isText(data.timeZone, 64)
             && isTimestampMs(data.createdAt)
             && isTimestampMs(data.updatedAt);
    }

    match /users/{userId}/closetItems/{itemId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validClosetItem(request.resource.data);
    }

    match /users/{userId}/schedules/{scheduleId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validSchedule(request.resource.data);
    }

    match /users/{userId}/outfits/{outfitId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validOutfit(request.resource.data);
    }

    match /users/{userId}/pushSubscriptions/{subscriptionId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validPushSubscription(request.resource.data);
    }

    // 送信済みの記録（reminderLog）は送信側だけが使う。
    // 下の「上記以外は拒否」に落ちるので、利用者からは読み書きできない。

    // アプリ自身の状態（サンプル投入済みフラグなど）。
    // 利用者のデータではないので、形だけ検証して素通しさせる。
    match /users/{userId}/meta/{docId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && request.resource.data.keys().hasOnly(['seededAt'])
                            && isTimestampMs(request.resource.data.seededAt);
    }

    // 上記以外は明示的に拒否する
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
