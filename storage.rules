rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // クローゼットの写真。自分の領域のみ読み書きできる。
    match /users/{userId}/closet/{fileName} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read, delete: if isOwner();

      // 保存前に長辺 640px へ縮小しているので、実測では最大でも 150KB 程度。
      // 1MB あれば十分な余裕がある。
      allow write: if isOwner()
                   && request.resource.size <= 1 * 1024 * 1024      // 1MB
                   && request.resource.contentType in ['image/jpeg', 'image/webp'];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
