# Firebase の設定値。未設定の場合はブラウザ内 (IndexedDB) 保存で動作します。
# 値は Firebase コンソール > プロジェクトの設定 > マイアプリ から取得してください。
# ※ これらは公開前提の識別子であり秘密鍵ではありません。
#    データの保護は firestore.rules / storage.rules で行います。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ローカルの Firebase エミュレータに接続する場合は true
VITE_USE_FIREBASE_EMULATOR=false
